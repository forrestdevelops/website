{
  "name": "forrestdevelops",
  "version": "1.0.0",
  "private": true,
  "description": "forrestdevelops website: TypeScript + Node (Express), server-rendered.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server.ts\" \"tsc -p tsconfig.client.json --watch --preserveWatchOutput\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "clean": "rm -rf dist public/js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
